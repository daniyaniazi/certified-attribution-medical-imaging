# HTCondor Submission File for Experiment 1 Faithfulness Evaluation
# Runs in docker container (GPU required for CUDA)

universe                = docker
docker_image            = nvidia/cuda:12.1.0-runtime-ubuntu22.04
initialdir              = /home/exml_team007/certified-attribution-medical-imaging
executable              = execute_experiment1_eval_faithfulness.sh
transfer_input_files    = execute_experiment1_eval_faithfulness.sh, experiment1_eval_faithfulness.py, src/, outputs/certifications/, outputs/checkpoints/

# Use default script arguments; override here if desired
arguments               = 

environment             = "PROJECT_ROOT=/home/exml_team007/certified-attribution-medical-imaging CONDA_PYTHON_BINARY_PATH=/home/exml_team007/miniconda3/envs/certified-attribution-medical-imaging/bin/python"

output                  = /home/exml_team007/condor_logs/experiment1_eval_faithfulness.$(ClusterId).$(ProcId).out
error                   = /home/exml_team007/condor_logs/experiment1_eval_faithfulness.$(ClusterId).$(ProcId).err
log                     = /home/exml_team007/condor_logs/experiment1_eval_faithfulness.$(ClusterId).log

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT

request_GPUs  = 1
request_CPUs  = 4
request_memory = 8G
request_disk   = 5G
requirements = UidDomain == "cs.uni-saarland.de"
+WantGPUHomeMounted = true
queue 1
