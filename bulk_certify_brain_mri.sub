# HTCondor Submission File for Brain MRI Bulk Certification (resnet18)
# Runs in docker container with parallel GPU support

universe                = docker
docker_image            = pytorch/pytorch:2.0.1-cuda11.8-cudnn8-devel
initialdir              = /home/exml_team007/certified-attribution-medical-imaging
executable              = bulk_certify_brain_mri.sh
transfer_input_files    = bulk_certify_brain_mri.sh

arguments               = --num_images 100 --num_samples 100 --batch_size 16 --sigma 0.15 --tau 0.75 --alpha 0.001 --k_percents 50 25 5 --panel_examples 3

environment             = "PROJECT_ROOT=/home/exml_team007/certified-attribution-medical-imaging CONDA_PYTHON_BINARY_PATH=/home/exml_team007/miniconda3/envs/certified-attribution-medical-imaging/bin/python"

output                  = /home/exml_team007/condor_logs/bulk_certify_brain_mri.$(ClusterId).$(ProcId).out
error                   = /home/exml_team007/condor_logs/bulk_certify_brain_mri.$(ClusterId).$(ProcId).err
log                     = /home/exml_team007/condor_logs/bulk_certify_brain_mri.$(ClusterId).log

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT

request_GPUs  = 1
request_CPUs  = 4
request_memory = 16G
request_disk   = 10G
requirements = UidDomain == "cs.uni-saarland.de"
+WantGPUHomeMounted = true
queue 1
