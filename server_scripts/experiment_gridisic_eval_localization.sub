# HTCondor Submission File for Grid ISIC Localization Evaluation
# Runs in docker container (no GPU required for evaluation)

universe                = docker
docker_image            = nvidia/cuda:12.1.0-runtime-ubuntu22.04
initialdir              = /home/exml_team007/certified-attribution-medical-imaging
executable              = execute_experiment_gridisic_eval_localization.sh
transfer_input_files    = execute_experiment_gridisic_eval_localization.sh, experiment_gridisic_eval_localization.py, src/

# Use default script arguments; override here if desired
arguments               = 

environment             = "PROJECT_ROOT=/home/exml_team007/certified-attribution-medical-imaging CONDA_PYTHON_BINARY_PATH=/home/exml_team007/miniconda3/envs/certified-attribution-medical-imaging/bin/python"

output                  = /home/exml_team007/condor_logs/experiment_gridisic_eval_localization.$(ClusterId).$(ProcId).out
error                   = /home/exml_team007/condor_logs/experiment_gridisic_eval_localization.$(ClusterId).$(ProcId).err
log                     = /home/exml_team007/condor_logs/experiment_gridisic_eval_localization.$(ClusterId).log

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT

request_GPUs  = 0
request_CPUs  = 4
request_memory = 16G
request_disk   = 20G
requirements = UidDomain == "cs.uni-saarland.de"
+WantGPUHomeMounted = true
queue 1
